{
  "name": "harmonise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "cd server && npm run build && cd ../client && npm run build",
    "start": "cd server && npm run start && cd ../client && npm run start",
    "test": "cd server && npm run test && cd ../client && npm run test",
    "eject": "cd server && npm run eject && cd ../client && npm run eject",
    "install": "cd server && npm install && cd ../client && npm install && cd .. && npm run format:watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'client/src/components/**/*.{ts,tsx,js,jsx}' 'server/**/*.{ts,js}'",
    "lint:fix": "eslint --fix 'client/src/**/*.{ts,tsx,js,jsx}' 'server/**/*.{ts,js}'",
    "format": "prettier --write 'client/src/**/*.{ts,tsx,js,jsx}' 'server/**/*.{ts,js,json,css,scss,md}'",
    "lint:watch": "chokidar 'client/src/**/*.{ts,tsx,js,jsx}' 'server/**/*.{ts,js}' -c 'eslint --fix \"client/src/**/*.{ts,tsx,js,jsx}\" \"server/**/*.{ts,js}\"'",
  "format:watch": "chokidar 'client/src/**/*.{ts,tsx,js,jsx}' 'server/**/*.{ts,js,json,css,scss,md}' -c 'prettier --write \"client/src/**/*.{ts,tsx,js,jsx}\" \"server/**/*.{ts,js,json,css,scss,md}\"'"

  
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@swc/core": "^1.15.3",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.7.4"
  }
}
